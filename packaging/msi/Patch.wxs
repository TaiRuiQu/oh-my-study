<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Patch Id="$(var.PatchCode)" AllowRemoval="yes" Classification="Update"
         DisplayName="$(var.ProductName) $(var.PatchVersion)" Manufacturer="Oh My Study"
         Description="$(var.ProductName) $(var.BaselineVersion) → $(var.PatchVersion)"
         OptimizePatchSizeForLargeFiles="yes" MinorUpdateTargetRTM="yes">
    <Media Id="1" Cabinet="patch.cab" CompressionLevel="high">
      <PatchBaseline Id="Baseline" BaselineFile="$(var.BaselineMsi)" UpdateFile="$(var.UpdateMsi)">
        <Validate ProductId="yes" UpgradeCode="yes" ProductLanguage="yes" ProductVersion="Update" ProductVersionOperator="Equal" />
      </PatchBaseline>
    </Media>
    <PatchFamily Id="OhMyStudyUpdates" Version="$(var.PatchVersion)" Supersede="yes" />
  </Patch>
</Wix>
