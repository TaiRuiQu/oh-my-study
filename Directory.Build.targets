<Project>
  <ItemGroup>
    <_OfficialAnthropicPackage Include="@(PackageReference->WithMetadataValue('Identity', 'Anthropic'))" />
    <_OfficialAnthropicConsumer Include="@(ProjectReference->WithMetadataValue('Filename', 'OhMyStudy.Infrastructure'))" />
  </ItemGroup>
  <Target Name="EnableManagedAnthropicSerialization" BeforeTargets="_GenerateRuntimeConfigurationFilesInputCache"
          Condition="'$(PublishAot)' != 'true' And ('@(_OfficialAnthropicPackage)' != '' Or '@(_OfficialAnthropicConsumer)' != '')">
    <!-- Temporary managed-runtime requirement of the official Anthropic SDK.
         Remove after switching to TairuiQu.Anthropic.Aot and validating it.
         Applied to the consumer's runtime configuration; Native AOT keeps the strict default. -->
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" />
      <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="true" />
    </ItemGroup>
  </Target>
  <Target Name="RequireAotCompatibleAnthropicSdk" BeforeTargets="PrepareForBuild"
          Condition="('@(_OfficialAnthropicPackage)' != '' Or '@(_OfficialAnthropicConsumer)' != '') And ('$(PublishAot)' == 'true' Or '$(PublishTrimmed)' == 'true')">
    <Error Text="Anthropic 12.58.0 requires an untrimmed managed runtime. Use -p:PublishAot=false -p:PublishTrimmed=false for this interim integration. Replace Anthropic with TairuiQu.Anthropic.Aot after the user announces it, then remove this guard and revalidate trimming and Native AOT." />
  </Target>
</Project>
