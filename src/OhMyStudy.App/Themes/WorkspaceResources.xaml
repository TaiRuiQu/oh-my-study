<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OhMyStudy.App.Controls">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FF171A20" />
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#FF262B33" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="#FF414852" />
            <SolidColorBrush x:Key="TaskAccentBrush" Color="#FF70D6CC" />
            <SolidColorBrush x:Key="TaskAccentBackgroundBrush" Color="#FF173F42" />
            <Color x:Key="TaskErrorColor">#FFFFB4AB</Color>
            <SolidColorBrush x:Key="TaskErrorBrush" Color="{ThemeResource TaskErrorColor}" />
            <SolidColorBrush x:Key="TaskSecondaryBrush" Color="#FFB7C0CC" />
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#FF17191D" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#FF24262B" />
            <SolidColorBrush x:Key="PaperBrush" Color="#FFFDFCF8" />
            <SolidColorBrush x:Key="PaperInkBrush" Color="#FF202734" />
            <SolidColorBrush x:Key="PaperMutedBrush" Color="#FF657080" />
            <SolidColorBrush x:Key="SourceHighlightBrush" Color="#205A9CFF" />
            <SolidColorBrush x:Key="SourceHighlightBorderBrush" Color="#FF5A9CFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFE9EDF2" />
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="#FFCBD2DC" />
            <SolidColorBrush x:Key="TaskAccentBrush" Color="#FF087F79" />
            <SolidColorBrush x:Key="TaskAccentBackgroundBrush" Color="#FFE0F3EF" />
            <Color x:Key="TaskErrorColor">#FFB42318</Color>
            <SolidColorBrush x:Key="TaskErrorBrush" Color="{ThemeResource TaskErrorColor}" />
            <SolidColorBrush x:Key="TaskSecondaryBrush" Color="#FF53637B" />
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="#FFEAEDF1" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="#FFF8F9FC" />
            <SolidColorBrush x:Key="PaperBrush" Color="#FFFDFCF8" />
            <SolidColorBrush x:Key="PaperInkBrush" Color="#FF202734" />
            <SolidColorBrush x:Key="PaperMutedBrush" Color="#FF657080" />
            <SolidColorBrush x:Key="SourceHighlightBrush" Color="#205A75FF" />
            <SolidColorBrush x:Key="SourceHighlightBorderBrush" Color="#FF4968E8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI</FontFamily>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TaskAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TaskAccentBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <Color x:Key="TaskErrorColor">{ThemeResource SystemColorWindowTextColor}</Color>
            <SolidColorBrush x:Key="TaskErrorBrush" Color="{ThemeResource TaskErrorColor}" />
            <SolidColorBrush x:Key="TaskSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WorkspaceCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="WorkspaceSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PaperInkBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PaperMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SourceHighlightBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SourceHighlightBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- Interface and reading text stay non-serif by default; explicit serif spans and printed output use 新宋体 (NSimSun).
         These keys are redefined here because this dictionary is merged after XamlControlsResources,
         where the framework fixes FontFamily to XamlAutoFontFamily. Redefining them applies the
         interface family to every existing usage without touching each control. -->
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource BodyStrongTextBlockFontSize}" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleTextBlockFontSize}" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource CaptionTextBlockFontSize}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="PanelHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="QuietTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="PaperTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PaperInkBrush}" />
        <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="31" />
    </Style>
    <Style x:Key="NeutralChipStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3,10,4" />
        <Setter Property="Background" Value="{ThemeResource SystemFillColorNeutralBackgroundBrush}" />
    </Style>
    <Style x:Key="CorrectChipStyle" TargetType="Border" BasedOn="{StaticResource NeutralChipStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
    <Style x:Key="PartialChipStyle" TargetType="Border" BasedOn="{StaticResource NeutralChipStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCautionBackgroundBrush}" />
    </Style>
    <Style x:Key="IncorrectChipStyle" TargetType="Border" BasedOn="{StaticResource NeutralChipStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
    </Style>
    <Style x:Key="ReviewChipStyle" TargetType="Border" BasedOn="{StaticResource NeutralChipStyle}">
        <Setter Property="Background" Value="{ThemeResource SystemFillColorAttentionBackgroundBrush}" />
    </Style>
    <Style x:Key="NeutralIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="CorrectIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style x:Key="PartialIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="IncorrectIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style x:Key="ReviewIconStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
    </Style>
    <Style TargetType="controls:ColumnSplitter">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ColumnSplitter">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Divider.Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" /></VisualState.Setters></VisualState>
                                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Divider.Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" /></VisualState.Setters></VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Divider" Width="1" Background="{ThemeResource WorkspaceBorderBrush}" HorizontalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
        </ResourceDictionary>
