                                            <TextBox x:Name="ProviderUrl" Grid.Row="1" Header="{l:Text Key=S0543}" PlaceholderText="https://…" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                            <PasswordBox x:Name="ProviderKey" Grid.Row="1" Grid.Column="1" Header="{l:Text Key=S0544}" PlaceholderText="{l:Text Key=S0545}" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{l:Text Key=S0065}" Click="SaveProvider_Click" Style="{StaticResource AccentButtonStyle}" />
