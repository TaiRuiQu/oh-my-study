                            <StackPanel Spacing="12">
                                <ComboBox x:Name="ExecutionModePicker" Header="{l:Text Key=S0580}" MinWidth="280" SelectionChanged="ExecutionModePicker_SelectionChanged">
                                    <ComboBoxItem Content="{l:Text Key=S0581}" /><ComboBoxItem Content="{l:Text Key=S0582}" /><ComboBoxItem Content="{l:Text Key=S0583}" />
