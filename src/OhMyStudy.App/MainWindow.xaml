                            <Button FontSize="16" Content="{l:Text Key=S0202}" Click="OpenFiles_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
