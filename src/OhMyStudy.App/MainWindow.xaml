<Window
    x:Class="OhMyStudy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OhMyStudy.App.ViewModels"
    xmlns:domain="using:OhMyStudy.Domain"
    xmlns:controls="using:OhMyStudy.App.Controls"
    Title="Oh My Study">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" ActualThemeChanged="RootGrid_ActualThemeChanged" Background="{ThemeResource WorkspaceCanvasBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="ImportModelTemplate" x:DataType="domain:ModelConfig"><StackPanel Spacing="3" Padding="0,5" MaxWidth="380"><TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" /><TextBlock Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Id}" Style="{StaticResource QuietTextStyle}" /></StackPanel></DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Oh My Study" Height="48"
            IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/App.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="212"
            IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
            PaneDisplayMode="Auto" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="试卷" Tag="materials">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="题库" Tag="library" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="错题" Tag="mistakes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="任务" Tag="tasks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Margin="20,16,24,12" RowSpacing="8" AllowDrop="True" DragOver="Source_DragOver" Drop="Source_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkspaceHeader" ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SectionCaption" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="PageHeading" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="WorkspaceActions" Visibility="Collapsed" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ImportPaperButton" Click="OpenFiles_Click" AutomationProperties.Name="导入试卷，支持 PDF 或图片">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock Text="导入试卷" /></StackPanel>
                        </Button>
                        <Button x:Name="GradeButton" Click="Grade_Click" IsEnabled="False" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock Text="重新识别" /></StackPanel>
                        </Button>
                        <Button x:Name="PaperMoreButton" AutomationProperties.Name="更多试卷操作" ToolTipService.ToolTip="更多">
                            <FontIcon Glyph="&#xE712;" FontSize="18" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="PaperPagesAction" Text="管理页面" Click="ManagePages_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="PaperReferencesAction" Text="整理参考答案" Click="ReadReferences_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="PaperDetailSeparator" />
                                    <MenuFlyoutItem x:Name="PaperDeleteAction" Text="删除试卷" Click="DeletePaper_Click" Foreground="{ThemeResource TaskErrorBrush}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource TaskErrorBrush}" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid x:Name="DocumentToolbar" ColumnSpacing="12" RowSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button x:Name="BackToPapersButton" Click="BackToPapers_Click" ToolTipService.ToolTip="返回试卷列表">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="16" /><TextBlock Text="返回" /></StackPanel>
                        </Button>
                        <StackPanel x:Name="DocumentCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel x:Name="DocumentCommandGroupPrimary" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ViewOriginalButton" Click="ViewOriginal_Click" ToolTipService.ToolTip="查看原件">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B3;" FontSize="16" /><TextBlock Text="查看原件" /></StackPanel>
                                </Button>
                                <Button x:Name="AddReferenceButton" Click="AddReferences_Click" ToolTipService.ToolTip="添加参考答案页面">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock Text="添加参考答案" /></StackPanel>
                                </Button>
                                <Button x:Name="EditQuestionButton" Click="EditQuestion_Click" IsEnabled="False" ToolTipService.ToolTip="编辑当前题目 (Ctrl + E)">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="16" /><TextBlock Text="编辑题目" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <Border x:Name="DocumentCommandDivider" Width="1" Height="20" Margin="4,0" VerticalAlignment="Center" Background="{ThemeResource WorkspaceBorderBrush}" />
                            <StackPanel x:Name="DocumentCommandGroupSecondary" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ViewResultsButton" Click="ViewResults_Click" ToolTipService.ToolTip="查看识别结果">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FD;" FontSize="16" /><TextBlock Text="识别结果" /></StackPanel>
                                </Button>
                                <Button x:Name="PaperInfoButton" Click="EditPaperInfo_Click" ToolTipService.ToolTip="编辑试卷信息">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="16" /><TextBlock Text="试卷信息" /></StackPanel>
                                </Button>
                                <Button x:Name="ExportQuestionsButton" Click="ExportQuestions_Click" ToolTipService.ToolTip="导出题目">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="16" /><TextBlock Text="导出题目" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="WorkspaceNotice" IsOpen="False" IsClosable="True" Severity="Informational" CloseButtonClick="WorkspaceNotice_CloseButtonClick"
                        Title="示例资料" Message="可查看和编辑，修改不会保存。" />
                </StackPanel>
                <Grid x:Name="PapersPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="PaperFilters" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Name="PaperSearch" PlaceholderText="搜索试卷标题或学科" TextChanged="PaperFilters_Changed" AutomationProperties.Name="搜索试卷" />
                        <ComboBox x:Name="PaperSubjectFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="PaperFilter_SelectionChanged" AutomationProperties.Name="按学科筛选" />
                        <ComboBox x:Name="PaperSort" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="PaperFilter_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="试卷排序">
                            <x:String>最近导入</x:String><x:String>最早导入</x:String><x:String>标题</x:String><x:String>学科</x:String><x:String>得分率</x:String>
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="PaperCount" Grid.Row="1" Style="{StaticResource QuietTextStyle}" />
                    <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" Background="{ThemeResource WorkspaceSurfaceBrush}">
                        <Grid>
                            <ListView x:Name="PaperList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PaperList_ItemClick" HorizontalContentAlignment="Stretch" Padding="8" AutomationProperties.Name="试卷列表">
                                <ListView.ItemTemplate><DataTemplate x:DataType="vm:PaperViewModel">
                                    <Grid Padding="12,14" ColumnSpacing="16" ContextRequested="PaperRow_ContextRequested">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8D2;" FontSize="12" /><TextBlock Text="{x:Bind Subject}" Style="{StaticResource QuietTextStyle}" /><FontIcon Glyph="&#xE8F1;" FontSize="12" Margin="12,0,0,0" /><TextBlock Text="{x:Bind QuestionCount}" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE787;" FontSize="12" /><TextBlock Text="{x:Bind Imported}" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="{x:Bind Score}" HorizontalAlignment="Right" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock Text="得分 / 满分" HorizontalAlignment="Right" Style="{StaticResource QuietTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="PaperEmpty" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <FontIcon Glyph="&#xE8A5;" FontSize="32" />
                                <TextBlock x:Name="PaperEmptyTitle" Text="还没有试卷" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PaperEmptyMessage" Text="导入 PDF 或图片试卷，开始整理。" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="WorkspaceColumnsRight" Width="424" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="WorkspaceQuestionsRow" Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="SourcePane" Visibility="Collapsed" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12"
                        Background="{ThemeResource WorkspaceSurfaceBrush}" AllowDrop="True" DragOver="Source_DragOver" Drop="Source_Drop">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Padding="16,12" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="原件" Style="{StaticResource PanelHeadingStyle}" />
                                    <TextBlock x:Name="OriginalCaption" Style="{StaticResource QuietTextStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Click="RotateLeft_Click" ToolTipService.ToolTip="向左旋转 90°" AutomationProperties.Name="原件向左旋转九十度"><FontIcon Glyph="&#xE7AD;" FontSize="16" /></Button>
                                    <Button Click="RotateRight_Click" ToolTipService.ToolTip="向右旋转 90°" AutomationProperties.Name="原件向右旋转九十度"><FontIcon Glyph="&#xE7AD;" FontSize="16" FlowDirection="RightToLeft" /></Button>
                                    <Button Click="CloseOriginal_Click" ToolTipService.ToolTip="收起原件" AutomationProperties.Name="收起原件"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="SourceViewer" Grid.Row="1" Background="{ThemeResource WorkspaceCanvasBrush}" Padding="24"
                                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                MinZoomFactor="0.25" MaxZoomFactor="4" ViewChanged="SourceViewer_ViewChanged"
                                AutomationProperties.Name="原件视口，可缩放和平移">
                                <Canvas x:Name="PageCanvas" Width="760" Height="1040">
                                    <Grid x:Name="PaperPage" Width="760" Height="1040" Background="{ThemeResource PaperBrush}"
                                        AutomationProperties.Name="原件">
                                        <Grid.RenderTransform><CompositeTransform x:Name="PageTransform" CenterX="380" CenterY="520" /></Grid.RenderTransform>
                                        <StackPanel x:Name="SamplePaper" Margin="64,54,64,50" Spacing="18" Visibility="Collapsed">
                                            <TextBlock Text="OH MY STUDY" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource PaperMutedBrush}" />
                                            <TextBlock Text="函数与导数" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource PaperInkBrush}" />
                                            <TextBlock Text="学习练习" Style="{StaticResource PaperTextStyle}" FontSize="16" />
                                            <Border Height="1" Background="{ThemeResource PaperMutedBrush}" Opacity="0.3" Margin="0,4,0,4" />
                                            <TextBlock Text="1. 已知函数 f(x) = x³ − 3x，求函数在区间 [−2, 2] 上的最大值与最小值。" Style="{StaticResource PaperTextStyle}" />
                                            <TextBlock Text="解：f′(x) = 3x² − 3 = 3(x + 1)(x − 1)。&#x0a;令 f′(x) = 0，得 x = −1 或 x = 1。&#x0a;比较端点与驻点的函数值，得最大值 2，最小值 −2。" Style="{StaticResource PaperTextStyle}" FontSize="17" Margin="18,0,0,18" />
                                            <TextBlock Text="2. 直线 y = kx + 1 与抛物线 y = x² 交于 A、B 两点，求线段 AB 的长度。" Style="{StaticResource PaperTextStyle}" />
                                            <Grid Height="112" Margin="30,0,30,4">
                                                <Path Data="M 20,86 L 400,86 M 200,4 L 200,105" Stroke="{ThemeResource PaperMutedBrush}" StrokeThickness="1" />
                                                <Path Data="M 62,4 Q 202,170 342,4 M 60,100 L 330,15" Stroke="{ThemeResource PaperInkBrush}" StrokeThickness="2" />
                                                <TextBlock Text="x" Margin="406,72,0,0" Foreground="{ThemeResource PaperInkBrush}" />
                                                <TextBlock Text="y" Margin="210,0,0,0" Foreground="{ThemeResource PaperInkBrush}" />
                                            </Grid>
                                            <TextBlock Text="3. 设数列 {aₙ} 满足 a₁ = 1，aₙ₊₁ = 2aₙ + 1，写出通项公式并说明理由。" Style="{StaticResource PaperTextStyle}" />
                                        </StackPanel>
                                        <Image x:Name="ImportedImage" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="原件图片" />
                                        <Canvas x:Name="SourceOverlay" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                            <Border x:Name="SourceHighlight" Canvas.Left="48" Canvas.Top="228" Width="664" Height="188" CornerRadius="6" BorderThickness="2"
                                                BorderBrush="{ThemeResource SourceHighlightBorderBrush}" Background="{ThemeResource SourceHighlightBrush}" />
                                        </Canvas>
                                    </Grid>
                                </Canvas>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="PdfPageControls" Grid.ColumnSpan="3" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Button x:Name="PreviousPdfPage" Content="上一页" Click="PreviousPdfPage_Click" AutomationProperties.Name="显示上一页" />
                                    <TextBlock x:Name="PdfPageLabel" Text="第 1 / 1 页" VerticalAlignment="Center" />
                                    <Button x:Name="NextPdfPage" Content="下一页" Click="NextPdfPage_Click" AutomationProperties.Name="显示下一页" />
                                    <Button x:Name="CancelPreview" Content="取消加载" Click="CancelPreview_Click" IsEnabled="False" />
                                </StackPanel>
                                <Button Grid.Row="1" Click="FitPage_Click" Content="适合页面" ToolTipService.ToolTip="恢复适合视口的缩放" />
                                <Slider x:Name="ZoomSlider" Grid.Row="1" Grid.Column="1" Minimum="25" Maximum="400" Value="65" StepFrequency="5" Width="130"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="原件缩放百分比" />
                                <TextBlock x:Name="ZoomLabel" Grid.Row="1" Grid.Column="2" Text="65%" Width="44" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource QuietTextStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="QuestionPane" Grid.Column="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}">
                        <Grid x:Name="QuestionLayout">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="QuestionListColumn" Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="QuestionListRow" Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="QuestionListHeading" Padding="20,14" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="题目" Style="{StaticResource PanelHeadingStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="QuestionList" Grid.Row="1" Margin="8,0,8,8" Padding="0" SelectionMode="Single"
                                ItemsSource="{x:Bind ViewModel.Questions}" SelectedItem="{x:Bind ViewModel.SelectedQuestion, Mode=TwoWay}"
                                SelectionChanged="QuestionList_SelectionChanged" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="题目列表">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuestionViewModel">
                                        <StackPanel Padding="8,10" Spacing="6" HorizontalAlignment="Stretch">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind OutcomeLabel}" Style="{StaticResource QuietTextStyle}" />
                                            </Grid>
                                            <controls:QuestionPreview Item="{x:Bind Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ScrollViewer x:Name="QuestionDetail" Grid.Column="1" Grid.RowSpan="3" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0" Padding="24,20" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedQuestion.Label, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LocateSourceButton" Content="定位原件" Click="LocateSource_Click" />
                                            <Button Content="保存" Command="{x:Bind ViewModel.FinishEditCommand}" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer x:Name="QuestionContentHost" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="题目内容" IsTabStop="True" />
                                    <TextBox x:Name="AnswerEditor" Header="答案" AcceptsReturn="True" TextWrapping="Wrap"
                                        MinHeight="100" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind ViewModel.SelectedQuestion.Answer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="备注" PlaceholderText="记录你的理解或复习提示" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind ViewModel.SelectedQuestion.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyQuestionState" Grid.ColumnSpan="2" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360" Margin="24">
                                <FontIcon Glyph="&#xE8F1;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="EmptyQuestionTitle" Text="还没有题目" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyQuestionMessage" Text="在试卷页面导入 PDF 或图片，识别后题目会自动加入题库。" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="TasksPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12" SizeChanged="TasksPanel_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TaskListColumn" Width="268" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition x:Name="TaskListRow" Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="TaskSidebar" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,12,8,8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Text="最近任务" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0" />
                            <ListView x:Name="TaskPicker" Grid.Row="1" SelectionChanged="TaskPicker_SelectionChanged" HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.Name="任务列表" />
                        </Grid>
                    </Border>
                    <ComboBox x:Name="TaskCompactPicker" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="TaskCompactPicker_SelectionChanged" AutomationProperties.Name="选择任务" />
                    <Border x:Name="TaskDetail" Grid.Column="1" SizeChanged="TasksPanel_SizeChanged" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <ScrollViewer x:Name="TaskSummaryScroll" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TaskSummary" Spacing="24" Padding="24">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <FontIcon x:Name="TaskHeroIcon" Glyph="&#xE9F9;" FontSize="20" Foreground="{ThemeResource TaskAccentBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TaskTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" /><TextBlock x:Name="TaskSampleMark" Grid.Column="1" Text="示例" Style="{StaticResource QuietTextStyle}" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,0,0" /></Grid>
                                                <TextBlock x:Name="TaskSubtitle" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="TaskButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                            <Button x:Name="TaskPermissionButton" Content="查看执行请求" Click="TaskPermission_Click" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
                                            <Button x:Name="TaskCancelButton" Content="取消任务" Click="TaskCancel_Click" Visibility="Collapsed" />
                                            <Button x:Name="TaskLibraryButton" Content="查看题库" Click="TaskLibrary_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="8"><TextBlock Text="已读页面" Style="{StaticResource QuietTextStyle}" /><TextBlock x:Name="TaskPages" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="已存题目" Style="{StaticResource QuietTextStyle}" /><TextBlock x:Name="TaskQuestions" FontSize="20" FontWeight="SemiBold" /></StackPanel>
                                        <Grid x:Name="TaskCostRow" Grid.Column="2" RowSpacing="8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="预估费用" Style="{StaticResource QuietTextStyle}" VerticalAlignment="Center" />
                                                <HyperlinkButton x:Name="TaskUsageButton" Content="明细" Click="TaskUsage_Click" FontSize="12" Padding="4,0" MinHeight="16">
                                                    <FlyoutBase.AttachedFlyout>
                                                        <Flyout x:Name="TaskUsageFlyout" Placement="Bottom">
                                                            <StackPanel x:Name="TaskUsageDetails" Spacing="16" Width="300">
                                                                <TextBlock Text="费用与用量" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                                <TextBlock x:Name="TaskModelCalls" Style="{StaticResource QuietTextStyle}" />
                                                                <StackPanel x:Name="TaskTokenUsage" Spacing="8">
                                                                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock x:Name="TaskInputUsage" TextWrapping="Wrap" /><TextBlock x:Name="TaskOutputUsage" Grid.Column="1" TextWrapping="Wrap" /></Grid>
                                                                    <TextBlock x:Name="TaskInputUncached" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="TaskInputCached" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="TaskInputCacheWrite" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock x:Name="TaskNoUsage" Text="暂无用量记录" Style="{StaticResource QuietTextStyle}" Visibility="Collapsed" />
                                                                <TextBlock x:Name="TaskRateNote" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </FlyoutBase.AttachedFlyout>
                                                </HyperlinkButton>
                                            </StackPanel>
                                            <TextBlock x:Name="TaskUsage" Grid.Row="1" Text="—" FontSize="20" FontWeight="SemiBold" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
                                <Grid RowSpacing="12" Padding="24,16,24,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="执行日志" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="TaskProgress" IsActive="True" Width="14" Height="14" MinWidth="14" MinHeight="14" Visibility="Collapsed" AutomationProperties.Name="任务正在处理" /><TextBlock x:Name="TaskStateLabel" Style="{StaticResource QuietTextStyle}" Foreground="{ThemeResource TaskAccentBrush}" VerticalAlignment="Center" /></StackPanel><Button Grid.Column="3" Click="TaskLatest_Click" ToolTipService.ToolTip="滚动到最新记录" AutomationProperties.Name="滚动到最新记录"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74B;" FontSize="12" /><TextBlock Text="最新" /></StackPanel></Button></Grid>
                                    <ScrollViewer x:Name="TaskLogScroll" Grid.Row="1" HorizontalContentAlignment="Stretch" SizeChanged="TaskLog_SizeChanged" ViewChanged="TaskLog_ViewChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskLog" Spacing="0" Padding="0,0,4,20" /></ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="TaskEmpty" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="300" Margin="24">
                            <Border Background="{ThemeResource TaskAccentBackgroundBrush}" CornerRadius="24" Width="88" Height="88"><FontIcon Glyph="&#xE9F9;" FontSize="38" Foreground="{ThemeResource TaskAccentBrush}" /></Border>
                            <TextBlock Text="识别进度，随时可见" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="导入试卷后，在这里查看阅读、识别与保存的每一步。" Style="{StaticResource QuietTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button Content="导入试卷" Click="OpenFiles_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,0,4,16">
                        <TextBlock Text="模型" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Grid x:Name="ProviderLayout" ColumnSpacing="20" RowSpacing="16" SizeChanged="ProviderLayout_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProviderListColumn" Width="212" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border x:Name="ProviderSidebar" Padding="12" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="供应商" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="8,4" />
                                    <ListView x:Name="ProviderPicker" MinHeight="0" MaxHeight="420" Padding="0" Visibility="Collapsed" SelectionChanged="ProviderPicker_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="供应商列表">
                                        <ListView.ItemTemplate><DataTemplate x:DataType="domain:Provider"><TextBlock Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" TextTrimming="CharacterEllipsis" Margin="4,8" /></DataTemplate></ListView.ItemTemplate>
                                    </ListView>
                                    <Button Content="添加供应商" Click="NewProvider_Click" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="ProviderDetails" Grid.Column="1" Spacing="16">
                                <Border x:Name="ProviderSettingsCard" Padding="24" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="供应商设置" Style="{StaticResource PanelHeadingStyle}" />
                                        <Grid x:Name="ProviderFields" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <TextBox x:Name="ProviderName" Header="名称" PlaceholderText="供应商名称" />
                                            <ComboBox x:Name="ProtocolPicker" Grid.Column="1" Header="接口" SelectedIndex="0" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="OpenAI Responses" /><ComboBoxItem Content="Anthropic Messages" />
                                            </ComboBox>
                                            <TextBox x:Name="ProviderUrl" Grid.Row="1" Header="地址" PlaceholderText="https://…" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                            <PasswordBox x:Name="ProviderKey" Grid.Row="1" Grid.Column="1" Header="密钥" PlaceholderText="留空保留已有密钥" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="保存" Click="SaveProvider_Click" Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="DeleteProviderButton" Content="删除供应商" Click="DeleteProvider_Click" IsEnabled="False" />
                                        </StackPanel>
                                        <TextBlock x:Name="ProviderFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ModelSettingsCard" Padding="24" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="模型列表" Style="{StaticResource PanelHeadingStyle}" />
                                        <StackPanel x:Name="ModelActionButtons" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="FetchModelsButton" Content="导入模型" Click="RefreshModels_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                            <Button x:Name="AddModelButton" Content="添加模型" Click="NewModel_Click" HorizontalAlignment="Left" IsEnabled="False" />
                                            <Button x:Name="TestModelButton" Content="测试连接" Click="TestProvider_Click" HorizontalAlignment="Left" IsEnabled="False" ToolTipService.ToolTip="向所选模型发送简短请求，可能产生少量费用。" />
                                        </StackPanel>
                                        <ListView x:Name="ModelPicker" MinHeight="0" MaxHeight="240" Padding="0" Visibility="Collapsed" SelectionChanged="ModelPicker_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="模型列表">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="domain:ModelConfig">
                                                    <StackPanel Spacing="3" Padding="4,8" ToolTipService.ToolTip="{x:Bind Id}">
                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Id}" Style="{StaticResource QuietTextStyle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel x:Name="ModelEditor" Spacing="12" Visibility="Collapsed">
                                            <Grid x:Name="ModelIdentityFields" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBox x:Name="ModelDisplayName" Header="显示名" PlaceholderText="留空使用模型 ID" />
                                                <TextBox x:Name="ModelId" Grid.Column="1" Header="模型 ID" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                            </Grid>
                                            <TextBox x:Name="ModelContextWindow" Header="上下文窗口" PlaceholderText="未确认" />
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <CheckBox x:Name="ModelVision" Content="支持图片" IsThreeState="True" MinWidth="0" />
                                                <CheckBox x:Name="ModelTools" Content="支持工具" IsThreeState="True" MinWidth="0" />
                                            </StackPanel>
                                            <TextBlock Text="可选思考强度" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <VariableSizedWrapGrid x:Name="ModelThinkingOptions" Orientation="Horizontal" MaximumRowsOrColumns="7" />
                                            <TextBox x:Name="ModelThinkingBudget" Header="思考预算" PlaceholderText="留空不设置" />
                                            <TextBlock Text="仅选择此模型支持的强度；图片和工具能力未确认时保留横线。" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                            <TextBlock Text="价格" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <Grid x:Name="ModelPriceFields" ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <TextBox x:Name="ModelPriceInput" Header="输入（未命中）" PlaceholderText="未设置" TextChanged="ModelPrice_Changed" />
                                                <TextBox x:Name="ModelPriceCacheRead" Grid.Column="1" Header="输入（命中）" PlaceholderText="未设置" TextChanged="ModelPrice_Changed" />
                                                <TextBox x:Name="ModelPriceCacheWrite" Grid.Column="2" Header="缓存写入" PlaceholderText="未设置" TextChanged="ModelPrice_Changed" />
                                                <TextBox x:Name="ModelPriceOutput" Grid.Column="3" Header="输出" PlaceholderText="未设置" TextChanged="ModelPrice_Changed" />
                                                <ComboBox x:Name="ModelCurrency" Grid.Column="4" Header="货币" PlaceholderText="选择货币" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ModelPriceCurrency_Changed"><x:String>美元</x:String><x:String>人民币</x:String></ComboBox>
                                            </Grid>
                                            <TextBlock x:Name="ModelCnyPreview" TextWrapping="Wrap" Style="{StaticResource QuietTextStyle}" />
                                            <TextBlock x:Name="ModelExtraInfo" TextWrapping="Wrap" Style="{StaticResource QuietTextStyle}" />
                                            <Button Content="从 models.dev 填充" Click="FillModelCatalog_Click" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="ModelCatalogFeedback" TextWrapping="Wrap" Style="{StaticResource QuietTextStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="保存模型" Click="SaveModel_Click" Style="{StaticResource AccentButtonStyle}" />
                                                <Button x:Name="DeleteModelButton" Content="删除模型" Click="DeleteModel_Click" IsEnabled="False" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="ModelFeedback" Text="先保存供应商，再添加模型。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LibrarySectionTitle" Text="资料库" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="LibraryPath" Header="保存位置" IsReadOnly="True" TextWrapping="Wrap" />
                                <TextBlock Text="导入的原件会复制到资料库，删除原文件后仍可查看。" TextWrapping="Wrap" Style="{StaticResource QuietTextStyle}" />
                                <StackPanel x:Name="LibraryActionButtons" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ChangeLibraryButton" Content="更改位置" Click="ChangeLibrary_Click" HorizontalAlignment="Left" />
                                    <Button Content="选择已有资料库" Click="SelectLibrary_Click" HorizontalAlignment="Left" />
                                    <Button Content="打开文件夹" Click="OpenLibraryFolder_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock x:Name="LibraryFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="执行" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="ExecutionModePicker" Header="代码与命令" MinWidth="280" SelectionChanged="ExecutionModePicker_SelectionChanged">
                                    <ComboBoxItem Content="每次询问" /><ComboBoxItem Content="沙箱运行" /><ComboBoxItem Content="直接在本机运行" />
                                </ComboBox>
                                <TextBlock x:Name="ExecutionDescription" TextWrapping="Wrap" />
                                <CheckBox x:Name="SandboxNetworkToggle" Content="允许沙箱访问网络" Checked="SandboxNetworkToggle_Changed" Unchecked="SandboxNetworkToggle_Changed" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Border Padding="24" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <ComboBox x:Name="ThemePicker" Header="主题" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged" MinWidth="220">
                                    <ComboBoxItem Content="跟随 Windows" Tag="system" /><ComboBoxItem Content="浅色" Tag="light" /><ComboBoxItem Content="深色" Tag="dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Button Content="关于" Click="About_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="WorkspaceStatus" Grid.Row="3" ColumnSpacing="20" Padding="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel x:Name="TaskActivity" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="{x:Bind ViewModel.TaskStatus, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" VerticalAlignment="Center" />
                        <Button Content="取消任务" Command="{x:Bind ViewModel.CancelTaskCommand}" IsEnabled="{x:Bind ViewModel.IsTaskRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
