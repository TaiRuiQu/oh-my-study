                                            <Button FontSize="16" x:Name="TaskCancelButton" Content="{l:Text Key=S0521}" Click="TaskCancel_Click" Visibility="Collapsed" />
                                            <Button FontSize="16" x:Name="TaskLibraryButton" Content="{l:Text Key=S0522}" Click="TaskLibrary_Click" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
