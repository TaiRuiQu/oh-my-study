                            <StackPanel Spacing="12">
                                <ComboBox x:Name="ThemePicker" Header="{l:Text Key=S0586}" SelectedIndex="0" SelectionChanged="ThemePicker_SelectionChanged" MinWidth="220">
                                    <ComboBoxItem Content="{l:Text Key=S0587}" Tag="system" /><ComboBoxItem Content="{l:Text Key=S0588}" Tag="light" /><ComboBoxItem Content="{l:Text Key=S0589}" Tag="dark" />
                                </ComboBox>
                                <ComboBox x:Name="LanguagePicker" Header="{l:Text Key=S0590}" SelectionChanged="LanguagePicker_SelectionChanged" MinWidth="220" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{l:Text Key=S0587}" Tag="system" />
                                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                                    <ComboBoxItem Content="English" Tag="en-US" />
                                    <ComboBoxItem Content="日本語" Tag="ja-JP" />
                                    <ComboBoxItem Content="한국어" Tag="ko-KR" />
                                </ComboBox>
                                <TextBlock x:Name="LanguageFeedback" TextWrapping="Wrap" Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Button Content="{l:Text Key=S0593}" Click="About_Click" HorizontalAlignment="Left" />
                    </StackPanel>
