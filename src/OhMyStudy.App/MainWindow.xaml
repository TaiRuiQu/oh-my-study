                                <TextBlock x:Name="ExecutionDescription" TextWrapping="Wrap" />
                                <CheckBox x:Name="SandboxNetworkToggle" Content="{l:Text Key=S0584}" Checked="SandboxNetworkToggle_Changed" Unchecked="SandboxNetworkToggle_Changed" />
                            </StackPanel>
                        </Border>
                        <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0585}" Style="{StaticResource SubtitleTextBlockStyle}" />
