                                        <StackPanel Grid.Column="1" Spacing="8"><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0524}" Style="{StaticResource QuietTextStyle}" /><TextBlock x:Name="TaskQuestions" FontSize="24" FontWeight="SemiBold" /></StackPanel>
