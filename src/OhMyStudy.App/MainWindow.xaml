                                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="TaskTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="24" TextWrapping="Wrap" /><TextBlock TextWrapping="Wrap" x:Name="TaskSampleMark" Grid.Column="1" Text="{l:Text Key=S0519}" Style="{StaticResource QuietTextStyle}" Visibility="Collapsed" VerticalAlignment="Top" Margin="0,4,0,0" /></Grid>
                                                <TextBlock x:Name="TaskSubtitle" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel x:Name="TaskButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
