                                    <Button x:Name="ChangeLibraryButton" Content="{l:Text Key=S0576}" Click="ChangeLibrary_Click" HorizontalAlignment="Left" />
                                    <Button Content="{l:Text Key=S0577}" Click="SelectLibrary_Click" HorizontalAlignment="Left" />
                                    <Button Content="{l:Text Key=S0578}" Click="OpenLibraryFolder_Click" HorizontalAlignment="Left" />
                                </StackPanel>
                                <TextBlock x:Name="LibraryFeedback" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
