                        <TextBlock Text="{x:Bind ViewModel.TaskStatus, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" VerticalAlignment="Center" />
                        <Button Content="{l:Text Key=S0521}" Command="{x:Bind ViewModel.CancelTaskCommand}" IsEnabled="{x:Bind ViewModel.IsTaskRunning, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
