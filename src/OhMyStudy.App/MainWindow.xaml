                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Id}" Style="{StaticResource QuietTextStyle}" TextTrimming="CharacterEllipsis" />
