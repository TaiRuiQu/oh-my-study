<Window
    x:Class="OhMyStudy.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OhMyStudy.App.ViewModels"
    xmlns:domain="using:OhMyStudy.Domain"
    xmlns:controls="using:OhMyStudy.App.Controls"
    xmlns:l="using:OhMyStudy.App.Localization"
    Title="Oh My Study">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" ActualThemeChanged="RootGrid_ActualThemeChanged" Background="{ThemeResource WorkspaceCanvasBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="ImportModelTemplate" x:DataType="domain:ModelConfig"><StackPanel Spacing="3" Padding="0,5" MaxWidth="380"><TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" /><TextBlock Text="{x:Bind Id}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Id}" Style="{StaticResource QuietTextStyle}" /></StackPanel></DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="Oh My Study" Height="48"
            IsPaneToggleButtonVisible="True" PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <x:Double x:Key="TitleBarCompactHeight">48</x:Double>
                <x:Double x:Key="TitleBarExpandedHeight">48</x:Double>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/App.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="Navigation" Grid.Row="1" OpenPaneLength="212"
            IsPaneToggleButtonVisible="False" IsTitleBarAutoPaddingEnabled="False"
            IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
            PaneDisplayMode="Auto" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{l:Text Key=S0143}" Tag="materials">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Text Key=S0456}" Tag="library" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Text Key=S0011}" Tag="mistakes">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{l:Text Key=S0465}" Tag="tasks">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Margin="20,16,24,12" RowSpacing="8" AllowDrop="True" DragOver="Source_DragOver" Drop="Source_Drop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="WorkspaceHeader" ColumnSpacing="20" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SectionCaption" Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" />
                        <TextBlock x:Name="PageHeading" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="WorkspaceActions" Visibility="Collapsed" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ImportPaperButton" Click="OpenFiles_Click" AutomationProperties.Name="{l:Text Key=S0469}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0202}" /></StackPanel>
                        </Button>
                        <Button x:Name="GradeButton" Click="Grade_Click" IsEnabled="False" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0204}" /></StackPanel>
                        </Button>
                        <Button x:Name="PaperMoreButton" AutomationProperties.Name="{l:Text Key=S0470}" ToolTipService.ToolTip="{l:Text Key=S0471}">
                            <FontIcon Glyph="&#xE712;" FontSize="18" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="PaperPagesAction" Text="{l:Text Key=S0472}" Click="ManagePages_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem x:Name="PaperReferencesAction" Text="{l:Text Key=S0203}" Click="ReadReferences_Click">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator x:Name="PaperDetailSeparator" />
                                    <MenuFlyoutItem x:Name="PaperDeleteAction" Text="{l:Text Key=S0293}" Click="DeletePaper_Click" Foreground="{ThemeResource TaskErrorBrush}">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource TaskErrorBrush}" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="8">
                    <Grid x:Name="DocumentToolbar" ColumnSpacing="12" RowSpacing="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button x:Name="BackToPapersButton" Click="BackToPapers_Click" ToolTipService.ToolTip="{l:Text Key=S0473}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72B;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0239}" /></StackPanel>
                        </Button>
                        <StackPanel x:Name="DocumentCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <StackPanel x:Name="DocumentCommandGroupPrimary" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ViewOriginalButton" Click="ViewOriginal_Click" ToolTipService.ToolTip="{l:Text Key=S0474}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7B3;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0474}" /></StackPanel>
                                </Button>
                                <Button x:Name="AddReferenceButton" Click="AddReferences_Click" ToolTipService.ToolTip="{l:Text Key=S0475}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0476}" /></StackPanel>
                                </Button>
                                <Button x:Name="EditQuestionButton" Click="EditQuestion_Click" IsEnabled="False" ToolTipService.ToolTip="{l:Text Key=S0477}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE70F;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0077}" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <Border x:Name="DocumentCommandDivider" Width="1" Height="20" Margin="4,0" VerticalAlignment="Center" Background="{ThemeResource WorkspaceBorderBrush}" />
                            <StackPanel x:Name="DocumentCommandGroupSecondary" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ViewResultsButton" Click="ViewResults_Click" ToolTipService.ToolTip="{l:Text Key=S0478}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8FD;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0479}" /></StackPanel>
                                </Button>
                                <Button x:Name="PaperInfoButton" Click="EditPaperInfo_Click" ToolTipService.ToolTip="{l:Text Key=S0480}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0313}" /></StackPanel>
                                </Button>
                                <Button x:Name="ExportQuestionsButton" Click="ExportQuestions_Click" ToolTipService.ToolTip="{l:Text Key=S0037}">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74E;" FontSize="16" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0037}" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="WorkspaceNotice" IsOpen="False" IsClosable="True" Severity="Informational" CloseButtonClick="WorkspaceNotice_CloseButtonClick"
                        Title="{l:Text Key=S0399}" Message="{l:Text Key=S0400}" />
                </StackPanel>
                <Grid x:Name="PapersPanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid x:Name="PaperFilters" ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBox x:Name="PaperSearch" PlaceholderText="{l:Text Key=S0481}" TextChanged="PaperFilters_Changed" AutomationProperties.Name="{l:Text Key=S0482}" />
                        <ComboBox x:Name="PaperSubjectFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="PaperFilter_SelectionChanged" AutomationProperties.Name="{l:Text Key=S0483}" />
                        <ComboBox x:Name="PaperSort" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="PaperFilter_SelectionChanged" SelectedIndex="0" AutomationProperties.Name="{l:Text Key=S0484}">
                            <ComboBoxItem Content="{l:Text Key=S0594}" /><ComboBoxItem Content="{l:Text Key=S0595}" /><ComboBoxItem Content="{l:Text Key=S0308}" /><ComboBoxItem Content="{l:Text Key=S0084}" /><ComboBoxItem Content="{l:Text Key=S0596}" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="PaperCount" Grid.Row="1" Style="{StaticResource QuietTextStyle}" />
                    <Border Grid.Row="2" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" Background="{ThemeResource WorkspaceSurfaceBrush}">
                        <Grid>
                            <ListView x:Name="PaperList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="PaperList_ItemClick" HorizontalContentAlignment="Stretch" Padding="8" AutomationProperties.Name="{l:Text Key=S0485}">
                                <ListView.ItemTemplate><DataTemplate x:DataType="vm:PaperViewModel">
                                    <Grid Padding="12,14" ColumnSpacing="16" ContextRequested="PaperRow_ContextRequested">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8D2;" FontSize="12" /><TextBlock Text="{x:Bind Subject}" Style="{StaticResource QuietTextStyle}" /><FontIcon Glyph="&#xE8F1;" FontSize="12" Margin="12,0,0,0" /><TextBlock Text="{x:Bind QuestionCount}" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE787;" FontSize="12" /><TextBlock Text="{x:Bind Imported}" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                            <TextBlock Text="{x:Bind Score}" HorizontalAlignment="Right" FontSize="17" FontWeight="SemiBold" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0486}" HorizontalAlignment="Right" Style="{StaticResource QuietTextStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="PaperEmpty" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                                <FontIcon Glyph="&#xE8A5;" FontSize="32" />
                                <TextBlock TextWrapping="Wrap" x:Name="PaperEmptyTitle" Text="{l:Text Key=S0303}" FontSize="20" HorizontalAlignment="Center" />
                                <TextBlock x:Name="PaperEmptyMessage" Text="{l:Text Key=S0305}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="WorkspaceColumnsRight" Width="424" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="WorkspaceQuestionsRow" Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="SourcePane" Visibility="Collapsed" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12"
                        Background="{ThemeResource WorkspaceSurfaceBrush}" AllowDrop="True" DragOver="Source_DragOver" Drop="Source_Drop">
                        <Grid RowSpacing="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Padding="16,12" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0487}" Style="{StaticResource PanelHeadingStyle}" />
                                    <TextBlock x:Name="OriginalCaption" Style="{StaticResource QuietTextStyle}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Click="RotateLeft_Click" ToolTipService.ToolTip="{l:Text Key=S0488}" AutomationProperties.Name="{l:Text Key=S0489}"><FontIcon Glyph="&#xE7AD;" FontSize="16" /></Button>
                                    <Button Click="RotateRight_Click" ToolTipService.ToolTip="{l:Text Key=S0490}" AutomationProperties.Name="{l:Text Key=S0491}"><FontIcon Glyph="&#xE7AD;" FontSize="16" FlowDirection="RightToLeft" /></Button>
                                    <Button Click="CloseOriginal_Click" ToolTipService.ToolTip="{l:Text Key=S0492}" AutomationProperties.Name="{l:Text Key=S0492}"><FontIcon Glyph="&#xE711;" FontSize="14" /></Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="SourceViewer" Grid.Row="1" Background="{ThemeResource WorkspaceCanvasBrush}" Padding="24"
                                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ZoomMode="Enabled"
                                MinZoomFactor="0.25" MaxZoomFactor="4" ViewChanged="SourceViewer_ViewChanged"
                                AutomationProperties.Name="{l:Text Key=S0493}">
                                <Canvas x:Name="PageCanvas" Width="760" Height="1040">
                                    <Grid x:Name="PaperPage" Width="760" Height="1040" Background="{ThemeResource PaperBrush}"
                                        AutomationProperties.Name="{l:Text Key=S0487}">
                                        <Grid.RenderTransform><CompositeTransform x:Name="PageTransform" CenterX="380" CenterY="520" /></Grid.RenderTransform>
                                        <StackPanel x:Name="SamplePaper" Margin="64,54,64,50" Spacing="18" Visibility="Collapsed">
                                            <TextBlock Text="OH MY STUDY" FontSize="11" CharacterSpacing="160" Foreground="{ThemeResource PaperMutedBrush}" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0494}" FontSize="34" FontWeight="SemiBold" Foreground="{ThemeResource PaperInkBrush}" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0495}" Style="{StaticResource PaperTextStyle}" FontSize="16" />
                                            <Border Height="1" Background="{ThemeResource PaperMutedBrush}" Opacity="0.3" Margin="0,4,0,4" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0496}" Style="{StaticResource PaperTextStyle}" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0497}" Style="{StaticResource PaperTextStyle}" FontSize="17" Margin="18,0,0,18" />
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0498}" Style="{StaticResource PaperTextStyle}" />
                                            <Grid Height="112" Margin="30,0,30,4">
                                                <Path Data="M 20,86 L 400,86 M 200,4 L 200,105" Stroke="{ThemeResource PaperMutedBrush}" StrokeThickness="1" />
                                                <Path Data="M 62,4 Q 202,170 342,4 M 60,100 L 330,15" Stroke="{ThemeResource PaperInkBrush}" StrokeThickness="2" />
                                                <TextBlock Text="x" Margin="406,72,0,0" Foreground="{ThemeResource PaperInkBrush}" />
                                                <TextBlock Text="y" Margin="210,0,0,0" Foreground="{ThemeResource PaperInkBrush}" />
                                            </Grid>
                                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0499}" Style="{StaticResource PaperTextStyle}" />
                                        </StackPanel>
                                        <Image x:Name="ImportedImage" Visibility="Collapsed" Stretch="Uniform" AutomationProperties.Name="{l:Text Key=S0500}" />
                                        <Canvas x:Name="SourceOverlay" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                                            <Border x:Name="SourceHighlight" Canvas.Left="48" Canvas.Top="228" Width="664" Height="188" CornerRadius="6" BorderThickness="2"
                                                BorderBrush="{ThemeResource SourceHighlightBorderBrush}" Background="{ThemeResource SourceHighlightBrush}" />
                                        </Canvas>
                                    </Grid>
                                </Canvas>
                            </ScrollViewer>
                            <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel x:Name="PdfPageControls" Grid.ColumnSpan="3" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Button x:Name="PreviousPdfPage" Content="{l:Text Key=S0501}" Click="PreviousPdfPage_Click" AutomationProperties.Name="{l:Text Key=S0502}" />
                                    <TextBlock TextWrapping="Wrap" x:Name="PdfPageLabel" Text="{l:Text Key=S0503}" VerticalAlignment="Center" />
                                    <Button x:Name="NextPdfPage" Content="{l:Text Key=S0504}" Click="NextPdfPage_Click" AutomationProperties.Name="{l:Text Key=S0505}" />
                                    <Button x:Name="CancelPreview" Content="{l:Text Key=S0506}" Click="CancelPreview_Click" IsEnabled="False" />
                                </StackPanel>
                                <Button Grid.Row="1" Click="FitPage_Click" Content="{l:Text Key=S0507}" ToolTipService.ToolTip="{l:Text Key=S0508}" />
                                <Slider x:Name="ZoomSlider" Grid.Row="1" Grid.Column="1" Minimum="25" Maximum="400" Value="65" StepFrequency="5" Width="130"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" AutomationProperties.Name="{l:Text Key=S0509}" />
                                <TextBlock x:Name="ZoomLabel" Grid.Row="1" Grid.Column="2" Text="65%" Width="44" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource QuietTextStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="QuestionPane" Grid.Column="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Background="{ThemeResource WorkspaceCardBrush}">
                        <Grid x:Name="QuestionLayout">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="QuestionListColumn" Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="QuestionListRow" Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="QuestionListHeading" Padding="20,14" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0029}" Style="{StaticResource PanelHeadingStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" Style="{StaticResource QuietTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="QuestionList" Grid.Row="1" Margin="8,0,8,8" Padding="0" SelectionMode="Single"
                                ItemsSource="{x:Bind ViewModel.Questions}" SelectedItem="{x:Bind ViewModel.SelectedQuestion, Mode=TwoWay}"
                                SelectionChanged="QuestionList_SelectionChanged" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:Text Key=S0510}">
                                <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuestionViewModel">
                                        <StackPanel Padding="8,10" Spacing="6" HorizontalAlignment="Stretch">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind OutcomeLabel}" Style="{StaticResource QuietTextStyle}" />
                                            </Grid>
                                            <controls:QuestionPreview Item="{x:Bind Mode=OneWay}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ScrollViewer x:Name="QuestionDetail" Grid.Column="1" Grid.RowSpan="3" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1,0,0,0" Padding="24,20" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel Spacing="16">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedQuestion.Label, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LocateSourceButton" Content="{l:Text Key=S0511}" Click="LocateSource_Click" />
                                            <Button Content="{l:Text Key=S0065}" Command="{x:Bind ViewModel.FinishEditCommand}" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer x:Name="QuestionContentHost" VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:Text Key=S0512}" IsTabStop="True" />
                                    <TextBox x:Name="AnswerEditor" Header="{l:Text Key=S0513}" AcceptsReturn="True" TextWrapping="Wrap"
                                        MinHeight="100" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind ViewModel.SelectedQuestion.Answer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Header="{l:Text Key=S0514}" PlaceholderText="{l:Text Key=S0515}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        Text="{x:Bind ViewModel.SelectedQuestion.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel x:Name="EmptyQuestionState" Grid.ColumnSpan="2" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="360" Margin="24">
                                <FontIcon Glyph="&#xE8F1;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock TextWrapping="Wrap" x:Name="EmptyQuestionTitle" Text="{l:Text Key=S0014}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                                <TextBlock x:Name="EmptyQuestionMessage" Text="{l:Text Key=S0018}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource QuietTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="TasksPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12" SizeChanged="TasksPanel_SizeChanged">
                    <Grid.Resources>
                        <Style x:Key="QuietTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Style>
                        <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="FontWeight" Value="Normal" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions><ColumnDefinition x:Name="TaskListColumn" Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition x:Name="TaskListRow" Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
                    <Border x:Name="TaskSidebar" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,12,8,8">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0516}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0" />
                            <ListView x:Name="TaskPicker" Grid.Row="1" SelectionChanged="TaskPicker_SelectionChanged" HorizontalContentAlignment="Stretch" Padding="0" AutomationProperties.Name="{l:Text Key=S0517}" />
                        </Grid>
                    </Border>
                    <ComboBox x:Name="TaskCompactPicker" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="TaskCompactPicker_SelectionChanged" AutomationProperties.Name="{l:Text Key=S0518}" />
                    <Border x:Name="TaskDetail" Grid.Column="1" SizeChanged="TasksPanel_SizeChanged" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid>
