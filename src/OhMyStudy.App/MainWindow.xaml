                                                                    <TextBlock x:Name="TaskInputUncached" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="TaskInputCached" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                    <TextBlock x:Name="TaskInputCacheWrite" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock TextWrapping="Wrap" x:Name="TaskNoUsage" Text="{l:Text Key=S0528}" Style="{StaticResource QuietTextStyle}" Visibility="Collapsed" />
                                                                <TextBlock x:Name="TaskRateNote" Style="{StaticResource QuietTextStyle}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </FlyoutBase.AttachedFlyout>
                                                </HyperlinkButton>
                                            </StackPanel>
                                            <TextBlock x:Name="TaskUsage" Grid.Row="1" Text="—" FontSize="24" FontWeight="SemiBold" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="0,1,0,0">
                                <Grid RowSpacing="12" Padding="24,16,24,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0529}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="TaskProgress" IsActive="True" Width="14" Height="14" MinWidth="14" MinHeight="14" Visibility="Collapsed" AutomationProperties.Name="{l:Text Key=S0530}" /><TextBlock x:Name="TaskStateLabel" Style="{StaticResource QuietTextStyle}" Foreground="{ThemeResource TaskAccentBrush}" VerticalAlignment="Center" /></StackPanel><Button FontSize="16" Grid.Column="3" Click="TaskLatest_Click" ToolTipService.ToolTip="{l:Text Key=S0531}" AutomationProperties.Name="{l:Text Key=S0531}"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE74B;" FontSize="12" /><TextBlock TextWrapping="Wrap" Text="{l:Text Key=S0532}" /></StackPanel></Button></Grid>
                                    <ScrollViewer x:Name="TaskLogScroll" Grid.Row="1" HorizontalContentAlignment="Stretch" SizeChanged="TaskLog_SizeChanged" ViewChanged="TaskLog_ViewChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="TaskLog" Spacing="0" Padding="0,0,4,20" /></ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Border x:Name="TaskEmpty" Grid.ColumnSpan="2" Grid.RowSpan="2" Background="{ThemeResource WorkspaceCardBrush}" BorderBrush="{ThemeResource WorkspaceBorderBrush}" BorderThickness="1" CornerRadius="12">
