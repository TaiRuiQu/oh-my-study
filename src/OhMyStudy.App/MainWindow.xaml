                                                <Button x:Name="DeleteModelButton" Content="{l:Text Key=S0572}" Click="DeleteModel_Click" IsEnabled="False" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock x:Name="ModelFeedback" Text="{l:Text Key=S0164}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock TextWrapping="Wrap" x:Name="LibrarySectionTitle" Text="{l:Text Key=S0573}" Style="{StaticResource SubtitleTextBlockStyle}" />
