<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>OhMyStudy.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OhMyStudyPublishVariant)' != ''">
    <PublishAot Condition="'$(OhMyStudyPublishVariant)' == 'aot' Or '$(OhMyStudyPublishVariant)' == 'aot-avx512'">true</PublishAot>
    <PublishAot Condition="'$(OhMyStudyPublishVariant)' == 'self-contained' Or '$(OhMyStudyPublishVariant)' == 'framework-dependent'">false</PublishAot>
    <SelfContained Condition="'$(OhMyStudyPublishVariant)' == 'framework-dependent'">false</SelfContained>
    <SelfContained Condition="'$(OhMyStudyPublishVariant)' != 'framework-dependent'">true</SelfContained>
    <PublishTrimmed>$(PublishAot)</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Debug and explicit non-AOT builds must not overwrite the Release AOT lock. -->
    <NuGetLockFilePath Condition="'$(PublishAot)' != 'true'">packages.self-contained.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(OhMyStudyPublishVariant)' == 'framework-dependent'">packages.framework-dependent.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="VelociTex.Core" GeneratePathProperty="true" />
    <PackageReference Include="VelociTex.Rendering.Direct2D" GeneratePathProperty="true" />
    <PackageReference Include="VelociTex.WinUI" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(PkgVelociTex_Core)\LICENSE;$(PkgVelociTex_Core)\THIRD-PARTY-NOTICES.md" Link="licenses\VelociTex.Core\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgVelociTex_Core)\licenses\*" Link="licenses\VelociTex.Core\licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgVelociTex_Rendering_Direct2D)\LICENSE;$(PkgVelociTex_Rendering_Direct2D)\THIRD-PARTY-NOTICES.md" Link="licenses\VelociTex.Rendering.Direct2D\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgVelociTex_WinUI)\LICENSE;$(PkgVelociTex_WinUI)\THIRD-PARTY-NOTICES.md" Link="licenses\VelociTex.WinUI\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Ordinary builds need the same PDF decoder as the portable application. -->
  <PropertyGroup>
    <DocumentToolchain>$(MSBuildThisFileDirectory)..\..\output\migration\toolchain</DocumentToolchain>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(DocumentToolchain)\pdfium\pdfium.dll" Link="native\pdfium.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(DocumentToolchain)\pdfium\pdfium.dll')" />
    <Content Include="$(DocumentToolchain)\libwebp\libwebp-1.6.0-windows-x64\bin\dwebp.exe" Link="native\webp\dwebp.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(DocumentToolchain)\libwebp\libwebp-1.6.0-windows-x64\bin\dwebp.exe')" />
    <Content Include="$(DocumentToolchain)\typst-x86_64-pc-windows-msvc\typst.exe" Link="native\typst\typst.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(DocumentToolchain)\typst-x86_64-pc-windows-msvc\typst.exe')" />
  </ItemGroup>
  <Target Name="RequireDocumentTools" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="!Exists('$(DocumentToolchain)\pdfium\pdfium.dll')" Text="PDF dependency missing. Run ./probes/prepare-documents.ps1 before building the app." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.xml" LogicalName="OhMyStudy.App.Localization.%(Filename)%(Extension)" />
    <ProjectReference Include="../OhMyStudy.Documents/OhMyStudy.Documents.csproj" />
    <ProjectReference Include="../OhMyStudy.Infrastructure/OhMyStudy.Infrastructure.csproj" />
    <Content Include="Assets/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Native AOT's publish pipeline omits WinUI's generated resource outputs unless listed explicitly. -->
  <Target Name="IncludeNativeXamlPublishResources" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_NativeXamlResource Include="$(TargetDir)**\*.xbf" />
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(_NativeXamlResource)">
        <RelativePath>%(_NativeXamlResource.RecursiveDir)%(_NativeXamlResource.Filename)%(_NativeXamlResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI PRI resource index was not generated. Native AOT publish must include the application PRI and XBF files." />
    <Error Condition="!Exists('$(TargetDir)App.xbf') Or !Exists('$(TargetDir)MainWindow.xbf') Or !Exists('$(TargetDir)Themes\WorkspaceResources.xbf')" Text="Compiled WinUI XAML resources are missing. Build the WinUI application before publishing." />
  </Target>
</Project>
