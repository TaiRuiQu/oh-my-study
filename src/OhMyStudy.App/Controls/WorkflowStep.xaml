<UserControl
    x:Class="OhMyStudy.App.Controls.WorkflowStep"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="StepRoot" MinHeight="108" SizeChanged="StepRoot_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" /><ColumnDefinition Width="16" />
            <ColumnDefinition x:Name="CaptionColumn" Width="280" /><ColumnDefinition x:Name="FieldGap" Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.RowSpan="2">
            <Rectangle x:Name="Connector" Width="1" Margin="0,42,0,0" HorizontalAlignment="Center" Fill="{ThemeResource WorkspaceBorderBrush}" />
            <Border x:Name="Marker" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" Background="{ThemeResource TaskAccentBackgroundBrush}">
                <FontIcon x:Name="StepIcon" FontSize="16" Foreground="{ThemeResource TaskAccentBrush}" />
            </Border>
        </Grid>
        <StackPanel x:Name="Caption" Grid.Column="2" Spacing="6" Margin="0,6,0,24">
            <TextBlock x:Name="StepTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="StepDescription" FontSize="13" Foreground="{ThemeResource TaskSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ContentControl x:Name="FieldsHost" Grid.Column="4" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Margin="0,3,0,26" />
    </Grid>
</UserControl>
