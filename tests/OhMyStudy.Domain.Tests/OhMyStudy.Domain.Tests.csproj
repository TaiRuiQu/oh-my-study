<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Keep Debug/explicit non-AOT restores separate from the Release graph. -->
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' != 'true'">packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OhMyStudy.App/Localization/UiText.cs" Link="Localization/UiText.cs" />
    <Compile Include="../../src/OhMyStudy.App/Services/FormulaLineBreaks.cs" Link="Services/FormulaLineBreaks.cs" />
    <Compile Include="../../src/OhMyStudy.App/Services/WindowBounds.cs" Link="Services/WindowBounds.cs" />
    <EmbeddedResource Include="../../src/OhMyStudy.App/Localization/*.xml" LogicalName="OhMyStudy.App.Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/OhMyStudy.App/MainWindow.xaml" LogicalName="Localization.MainWindow.xaml" />
    <ProjectReference Include="../../src/OhMyStudy.Domain/OhMyStudy.Domain.csproj" />
    <None Include="../Fixtures/Compatibility/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
