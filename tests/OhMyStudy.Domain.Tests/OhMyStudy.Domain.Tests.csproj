  <ItemGroup>
    <ProjectReference Include="../../src/OhMyStudy.Domain/OhMyStudy.Domain.csproj" />
    <None Include="../Fixtures/Compatibility/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
