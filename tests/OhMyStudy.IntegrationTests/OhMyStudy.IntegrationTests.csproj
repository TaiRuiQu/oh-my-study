<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Keep Debug/explicit non-AOT restores separate from the Release graph. -->
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' != 'true'">packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OhMyStudy.Infrastructure/OhMyStudy.Infrastructure.csproj" />
    <None Include="../Fixtures/LegacyDatabase/*.sql" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
