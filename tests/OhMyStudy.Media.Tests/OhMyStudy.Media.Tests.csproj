<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <SelfContained>true</SelfContained>
    <!-- Keep Debug/explicit non-AOT restores separate from the Release graph. -->
    <NuGetLockFilePath Condition="'$(PublishAot)' == 'true'">packages.aot.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(PublishAot)' != 'true'">packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OhMyStudy.Infrastructure/OhMyStudy.Infrastructure.csproj" />
    <ProjectReference Include="../../src/OhMyStudy.Documents/OhMyStudy.Documents.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" />
    <Compile Include="../../src/OhMyStudy.App/Localization/GlobalUsings.cs" Link="Localization/GlobalUsings.cs" />
    <Compile Include="../../src/OhMyStudy.App/Localization/UiText.cs" Link="Localization/UiText.cs" />
    <EmbeddedResource Include="../../src/OhMyStudy.App/Localization/*.xml" LogicalName="OhMyStudy.App.Localization.%(Filename)%(Extension)" />
    <Compile Include="../../src/OhMyStudy.App/Services/NativePageImages.cs" Link="Services/NativePageImages.cs" />
    <Compile Include="../../src/OhMyStudy.App/Services/NativeMediaProcessor.cs" Link="Services/NativeMediaProcessor.cs" />
    <Compile Include="../../src/OhMyStudy.App/Services/PhonePhotoProcessor.cs" Link="Services/PhonePhotoProcessor.cs" />
    <EmbeddedResource Include="../../src/OhMyStudy.App/MobileCapture/index.html" LogicalName="PhoneCapture.html" />
    <Content Include="../../output/migration/toolchain/scanner/*" Link="native/scanner/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../packaging/docres/*" Link="native/docres/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../Fixtures/Compatibility/assets.synthetic.json" Link="Fixtures/assets.synthetic.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
