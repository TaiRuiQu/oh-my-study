{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oh My Study",
  "version": "0.1.0",
  "identifier": "io.ohmystudy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Oh My Study",
      "width": 1240,
      "height": 840,
      "minWidth": 900,
      "minHeight": 640
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "capabilities": ["main-capability"]
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
