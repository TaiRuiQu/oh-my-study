    "desktop:build": "tauri build --features desktop --no-bundle"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.344",
    "@radix-ui/react-dialog": "^1.1.15",
